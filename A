-- Xử lý Noclip
local function restoreCollisions()
	for part, canCollide in pairs(savedCollisions) do
		if part and part.Parent then
			part.CanCollide = canCollide
		end
	end
	table.clear(savedCollisions)
end

local function applyNoclip(char)
	if not char then return end
	for _, obj in ipairs(char:GetDescendants()) do
		if obj:IsA("BasePart") then
			if savedCollisions[obj] == nil then
				savedCollisions[obj] = obj.CanCollide
			end
			obj.CanCollide = false
		end
	end
end

-- Xử lý Fly Mobile (dùng MoveDirection + nút Lên/Xuống, không dùng phím PC)
local function stopFly()
	flyVerticalDir = 0
	setMobileFlyGuiVisible(false)
	if flyBodyGyro then
		flyBodyGyro:Destroy()
		flyBodyGyro = nil
	end
	if flyBodyVelocity then
		flyBodyVelocity:Destroy()
		flyBodyVelocity = nil
	end
end

local function startFly()
	stopFly()
	local char = LocalPlayer.Character
	local root = getRootPart(char)
	local hum = getHumanoid(char)
	if not char or not root then return end

	if hum then
		hum.PlatformStand = true
	end

	createMobileFlyControls()
	setMobileFlyGuiVisible(true)

	flyBodyGyro = Instance.new("BodyGyro")
	flyBodyGyro.P = 9e4
	flyBodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
	flyBodyGyro.CFrame = root.CFrame
	flyBodyGyro.Parent = root

	flyBodyVelocity = Instance.new("BodyVelocity")
	flyBodyVelocity.Velocity = Vector3.zero
	flyBodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
	flyBodyVelocity.Parent = root
end

local function getMobileFlyVelocity(hum)
	local moveVec = Vector3.zero
	if hum and hum.MoveDirection.Magnitude > 0.01 then
		moveVec += Vector3.new(hum.MoveDirection.X, 0, hum.MoveDirection.Z).Unit
	end
	if flyVerticalDir ~= 0 then
		moveVec += Vector3.new(0, flyVerticalDir, 0)
	end

	if moveVec.Magnitude > 0 then
		return moveVec.Unit * flySpeed
	end
	return Vector3.zero
end

-- Vòng FOV cố định ở giữa màn hình
local fovGui = nil
local fovFrame = nil
local fovStroke = nil

local function ensureFovUI()
	if fovFrame and fovFrame.Parent then return end
	local playerGui = LocalPlayer:FindFirstChildWhichIsA("PlayerGui")
	if not playerGui then return end

	local old = playerGui:FindFirstChild("TuanRayfield_FOV_UI")
	if old then old:Destroy() end

	local gui = Instance.new("ScreenGui")
	gui.Name = "TuanRayfield_FOV_UI"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 999
	gui.Parent = playerGui

	local circle = Instance.new("Frame")
	circle.Name = "FovCircle"
	circle.AnchorPoint = Vector2.new(0.5, 0.5)
	circle.BackgroundTransparency = 1
	circle.Visible = false
	circle.Parent = gui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = circle

	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Parent = circle

	fovGui = gui
	fovFrame = circle
	fovStroke = stroke
end

local function getFovCenter()
	local cam = workspace.CurrentCamera
	if cam then
		return Vector2.new(cam.ViewportSize.X * 0.5, cam.ViewportSize.Y * 0.5)
	end
	return Vector2.new(0, 0)
end

local function getClosestTargetInFOV()
	local cam = workspace.CurrentCamera
	if not cam then return nil end

	local centerPos = getFovCenter()
	local closestPart = nil
	local shortestDist = fovRadius

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			if teamCheckEnabled and isTeammate(player) then
				continue
			end

			local char = player.Character
			local hum = getHumanoid(char)
			if char and hum and hum.Health > 0 then
				local targetPart = resolveAimPart(char, aimPartChoice)
				if targetPart and isVisible(targetPart) then
					local screenPos, onScreen = cam:WorldToViewportPoint(targetPart.Position)
					if onScreen and screenPos.Z > 0 then
						local dist = (Vector2.new(screenPos.X, screenPos.Y) - centerPos).Magnitude
						if dist <= shortestDist then
							shortestDist = dist
							closestPart = targetPart
						end
					end
				end
			end
		end
	end

	return closestPart
end

-- Hệ thống ESP gọn nhẹ
local espObjects = {}

local function clearESPForPlayer(player)
	local data = espObjects[player]
	if data then
		if data.Highlight then data.Highlight:Destroy() end
		if data.Billboard then data.Billboard:Destroy() end
		espObjects[player] = nil
	end
end

local function updateESP()
	if not espEnabled then
		for player in pairs(espObjects) do
			clearESPForPlayer(player)
		end
		return
	end

	local localRoot = getRootPart(LocalPlayer.Character)

	for _, player in ipairs(Players:GetPlayers()) do
		if player == LocalPlayer then
			clearESPForPlayer(player)
			continue
		end

		local mate = isTeammate(player)
		if enemyOnly and mate then
			clearESPForPlayer(player)
			continue
		end

		local char = player.Character
		local head = char and char:FindFirstChild("Head")
		local root = getRootPart(char)
		local hum = getHumanoid(char)

		if not char or not head or not root or not hum or hum.Health <= 0 then
			clearESPForPlayer(player)
			continue
		end

		local data = espObjects[player]
		if not data then
			local hl = Instance.new("Highlight")
			hl.Name = "TuanRayfield_ESP"
			hl.FillTransparency = 0.65
			hl.OutlineTransparency = 0
			hl.Adornee = char
			hl.Parent = char

			local bb = Instance.new("BillboardGui")
			bb.Name = "TuanRayfield_Tag"
			bb.Adornee = head
			bb.Size = UDim2.new(0, 160, 0, 36)
			bb.StudsOffset = Vector3.new(0, 2.2, 0)
			bb.AlwaysOnTop = true
			bb.Parent = char

			local label = Instance.new("TextLabel")
			label.Size = UDim2.new(1, 0, 1, 0)
			label.BackgroundTransparency = 1
			label.TextStrokeTransparency = 0.2
			label.Font = Enum.Font.GothamBold
			label.TextSize = 13
			label.Parent = bb

			data = { Highlight = hl, Billboard = bb, Label = label }
			espObjects[player] = data
		end

		local colorToUse = mate and friendColor or (rainbowEnabled and rainbowColor or Color3.fromRGB(255, 60, 60))
		data.Highlight.FillColor = colorToUse
		data.Highlight.OutlineColor = colorToUse

		local distText = ""
		if localRoot then
			distText = string.format(" [%dm]", math.floor((root.Position - localRoot.Position).Magnitude))
		end
		data.Label.Text = string.format("%s | %d HP%s", player.DisplayName, math.floor(hum.Health), distText)
		data.Label.TextColor3 = colorToUse
	end
end

