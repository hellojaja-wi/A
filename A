-- Hàm tìm server & hop server (lọc chặt playing == 1 để khi mình vào thành 2, không tính mình)
local function fetchServers(placeId, predicate)
	local cursor = ""
	local resultList = {}

	for _ = 1, 6 do
		local url = string.format(
			"https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100%s",
			placeId,
			cursor ~= "" and ("&cursor=" .. cursor) or ""
		)

		local ok, raw = pcall(function()
			return game:HttpGet(url)
		end)
		if not ok or not raw then break end

		local okDecode, decoded = pcall(function()
			return HttpService:JSONDecode(raw)
		end)
		if not okDecode or not decoded or not decoded.data then break end

		for _, srv in ipairs(decoded.data) do
			if srv.id and srv.id ~= game.JobId and type(srv.playing) == "number" and type(srv.maxPlayers) == "number" and srv.playing < srv.maxPlayers then
				if not predicate or predicate(srv) then
					table.insert(resultList, srv)
				end
			end
		end

		if decoded.nextPageCursor then
			cursor = decoded.nextPageCursor
		else
			break
		end
	end

	return resultList
end

local function hopServer()
	local servers = fetchServers(game.PlaceId)
	if #servers > 0 then
		local chosen = servers[math.random(1, #servers)]
		TeleportService:TeleportToPlaceInstance(game.PlaceId, chosen.id, LocalPlayer)
	else
		Rayfield:Notify({
			Title = "Server Hop",
			Content = "Không tìm thấy server khả dụng khác.",
			Duration = 4
		})
	end
end

local function findOnePlayerServer()
	local servers = fetchServers(game.PlaceId, function(srv)
		return srv.playing == 1 and srv.maxPlayers >= 2
	end)

	if #servers > 0 then
		local picked = servers[math.random(1, #servers)]
		foundOnePlayerServer = picked.id
		Rayfield:Notify({
			Title = "Tìm Server 1 Người",
			Content = "Thấy server 1 người (vào thành 2): " .. tostring(foundOnePlayerServer),
			Duration = 5
		})
	else
		foundOnePlayerServer = nil
		Rayfield:Notify({
			Title = "Tìm Server 1 Người",
			Content = "Không có server 1 người nào hiện tại (tránh server 2+ người).",
			Duration = 4
		})
	end
end

local function joinOnePlayerServer()
	local freshServers = fetchServers(game.PlaceId, function(srv)
		return srv.playing == 1 and srv.maxPlayers >= 2
	end)

	if #freshServers > 0 then
		local targetId = foundOnePlayerServer
		local valid = false
		for _, srv in ipairs(freshServers) do
			if targetId and srv.id == targetId then
				valid = true
				break
			end
		end
		if not valid then
			targetId = freshServers[1].id
			foundOnePlayerServer = targetId
		end

		TeleportService:TeleportToPlaceInstance(game.PlaceId, targetId, LocalPlayer)
	else
		foundOnePlayerServer = nil
		Rayfield:Notify({
			Title = "Vào Server 1 Người",
			Content = "Không tìm thấy server 1 người hợp lệ (sẽ thành 3 nếu vào server 2 người).",
			Duration = 4
		})
	end
end

-- Vòng lặp chính mỗi frame
RunService.RenderStepped:Connect(function()
	local char = LocalPlayer.Character
	local hum = getHumanoid(char)
	local root = getRootPart(char)

	if hum then
		if walkSpeedEnabled then
			hum.WalkSpeed = targetWalkSpeed
		end
		if jumpPowerEnabled then
			hum.UseJumpPower = true
			hum.JumpPower = targetJumpPower
		end
	end

	if noclipEnabled and char then
		applyNoclip(char)
	end

	if flyEnabled and root then
		if not flyBodyGyro or not flyBodyVelocity then
			startFly()
		end
		if flyBodyGyro and flyBodyVelocity then
			local cam = workspace.CurrentCamera
			if cam then
				flyBodyGyro.CFrame = CFrame.lookAt(root.Position, root.Position + cam.CFrame.LookVector)
			end
			flyBodyVelocity.Velocity = getMobileFlyVelocity(hum)
		end
	end

	ensureFovUI()
	if fovFrame and fovStroke then
		local showFov = aimbotEnabled and fovEnabled
		fovFrame.Visible = showFov
		if showFov then
			local center = getFovCenter()
			local diameter = fovRadius * 2
			fovFrame.Position = UDim2.fromOffset(center.X, center.Y)
			fovFrame.Size = UDim2.fromOffset(diameter, diameter)
			fovStroke.Color = rainbowEnabled and rainbowColor or Color3.fromRGB(255, 255, 255)
		end
	end

	if aimbotEnabled then
		local cam = workspace.CurrentCamera
		local targetPart = getClosestTargetInFOV()
		if cam and targetPart then
			local targetCFrame = CFrame.lookAt(cam.CFrame.Position, targetPart.Position)
			cam.CFrame = cam.CFrame:Lerp(targetCFrame, math.clamp(aimSmoothness, 0.01, 1))
		end
	end

	updateESP()
end)

